# Shared LiteLLM management credential
#required: dedicated LiteLLM administrative virtual key
#secret
LITELLM_MCP_SWITCHER_ADMIN_VIRTUAL_KEY=

# Managed LiteLLM keys; existing keys are retained on reruns.
#repeat-group: LITELLM_MCP_SWITCHER_KEY suffix02 LITELLM_MCP_SWITCHER_KEY_NAME LITELLM_MCP_SWITCHER_KEY_SWITCHER_BEARER LITELLM_MCP_SWITCHER_KEY_ALLOWED_MCPS LITELLM_MCP_SWITCHER_KEY_BEARER LITELLM_MCP_SWITCHER_KEY_ALWAYS_ON_MCPS
#repeat-optional-complete: LITELLM_MCP_SWITCHER_KEY_SWITCHER_BEARER LITELLM_MCP_SWITCHER_KEY_ALLOWED_MCPS LITELLM_MCP_SWITCHER_KEY_ALWAYS_ON_MCPS
#repeat-unique: LITELLM_MCP_SWITCHER_KEY_NAME
#required: unique managed LiteLLM key name
LITELLM_MCP_SWITCHER_KEY_NAME=main

# Optional personal Switcher login; omit for keys managed only by an orchestrator.
#secret
LITELLM_MCP_SWITCHER_KEY_SWITCHER_BEARER=example: openssl rand -hex 32

# Initial ceiling for key creation: CSV of existing LiteLLM MCP aliases.
# Optional when entering an existing key; required for API key creation.
LITELLM_MCP_SWITCHER_KEY_ALLOWED_MCPS=

#required: assigned LiteLLM MCP bearer
#secret
#create-with: litellm_add_virtual.py
LITELLM_MCP_SWITCHER_KEY_BEARER=

# CSV of aliases retained with all permitted tools on every Apply.
LITELLM_MCP_SWITCHER_KEY_ALWAYS_ON_MCPS=

# Optional orchestrator logins, separate from the managed LiteLLM keys.
#repeat-group: LITELLM_MCP_SWITCHER_ORCHESTRATOR suffix02 LITELLM_MCP_SWITCHER_ORCHESTRATOR_NAME LITELLM_MCP_SWITCHER_ORCHESTRATOR_BEARER LITELLM_MCP_SWITCHER_ORCHESTRATOR_KEY_NAMES
#repeat-optional-group: LITELLM_MCP_SWITCHER_ORCHESTRATOR
#repeat-unique: LITELLM_MCP_SWITCHER_ORCHESTRATOR_NAME
#required: unique orchestrator name
LITELLM_MCP_SWITCHER_ORCHESTRATOR_NAME=orchestrator

# Login to the Switcher MCP, WebUI and REST API.
#required: orchestrator bearer
#secret
LITELLM_MCP_SWITCHER_ORCHESTRATOR_BEARER=example: openssl rand -hex 32

# CSV referencing configured LITELLM_MCP_SWITCHER_KEY_NAME values, in default order.
#required: at least one existing managed key name
LITELLM_MCP_SWITCHER_ORCHESTRATOR_KEY_NAMES=

# Database
#choices: sqlite postgres mariadb
#default-preset: sqlite
#required: database backend
#named-volume: /named_volumes/LITELLM_MCP_SWITCHER_SQLITE /named_volumes/LITELLM_MCP_SWITCHER_SQLITE /opt/f24sales/litellm-mcp-switcher/sqlite dir
LITELLM_MCP_SWITCHER_DB_BACKEND=sqlite

#blank-if: LITELLM_MCP_SWITCHER_DB_BACKEND=sqlite LITELLM_MCP_SWITCHER_DB_HOST LITELLM_MCP_SWITCHER_DB_PORT LITELLM_MCP_SWITCHER_DB_NAME LITELLM_MCP_SWITCHER_DB_USER LITELLM_MCP_SWITCHER_DB_PW LITELLM_MCP_SWITCHER_DB_PREFIX
#required: database host
LITELLM_MCP_SWITCHER_DB_HOST=host.containers.internal

#default-if: LITELLM_MCP_SWITCHER_DB_BACKEND=postgres 5432
#default-if: LITELLM_MCP_SWITCHER_DB_BACKEND=mariadb 3306
#required: database port
LITELLM_MCP_SWITCHER_DB_PORT=5432

#required: database name
LITELLM_MCP_SWITCHER_DB_NAME=litellm_mcp_switcher

#required: database user
LITELLM_MCP_SWITCHER_DB_USER=litellm_mcp_switcher

#required: database password
#secret
LITELLM_MCP_SWITCHER_DB_PW=

#default-preset: litellm_mcp_switcher
LITELLM_MCP_SWITCHER_DB_PREFIX=litellm_mcp_switcher
