# ── LiteLLM administration ─────────────────────────────
#required: dedicated LiteLLM administrative virtual key
#secret
LITELLM_ADMIN_VIRTUAL_KEY=

# ── Users ──────────────────────────────────────────────
#repeat-group: USER suffix02 USER_NAME USER_SWITCHER_BEARER USER_LITELLM_BEARER USER_ALWAYS_ON_MCPS
#required: unique user name
USER_NAME=rafael

# Login to the Switcher WebUI, REST API and MCP
#required: user Switcher bearer
#secret
USER_SWITCHER_BEARER=

# Assigned LiteLLM MCP bearer; never an existing LLM key
#required: assigned LiteLLM MCP bearer
#secret
USER_LITELLM_BEARER=

# Comma-separated registry aliases retained with all tools on every Apply.
# Leave blank for no always-on MCPs. Configure separately for each user.
USER_ALWAYS_ON_MCPS=

# ── Database ───────────────────────────────────────────
#choices: sqlite postgres mariadb
#default-preset: sqlite
#required: database backend
#named-volume: /named_volumes/MCP_SWITCHER_SQLITE /named_volumes/MCP_SWITCHER_SQLITE /opt/f24sales/litellm-mcp-switcher/sqlite dir
MCP_SWITCHER_DB_BACKEND=sqlite

#blank-if: MCP_SWITCHER_DB_BACKEND=sqlite MCP_SWITCHER_DB_HOST MCP_SWITCHER_DB_PORT MCP_SWITCHER_DB_NAME MCP_SWITCHER_DB_USER MCP_SWITCHER_DB_PW MCP_SWITCHER_DB_PREFIX
#required: database host
MCP_SWITCHER_DB_HOST=host.containers.internal

#default-if: MCP_SWITCHER_DB_BACKEND=postgres 5432
#default-if: MCP_SWITCHER_DB_BACKEND=mariadb 3306
#required: database port
MCP_SWITCHER_DB_PORT=5432

#required: database name
MCP_SWITCHER_DB_NAME=litellm_mcp_switcher

#required: database user
MCP_SWITCHER_DB_USER=litellm_mcp_switcher

#required: database password
#secret
MCP_SWITCHER_DB_PW=

#default-preset: mcp_switcher
MCP_SWITCHER_DB_PREFIX=mcp_switcher
