LITELLM_MCP_SWITCHER_API_BASE_URL=http://litellm:4000
LITELLM_MCP_SWITCHER_REQUEST_TIMEOUT_SECONDS=30

# WebUI and REST API listen internally on port 8080
#choices: 0 1
#default-preset: 1
LITELLM_MCP_SWITCHER_WEBUI_ENABLED=1

# MCP listens internally on port 8000
#choices: 0 1
#default-preset: 1
LITELLM_MCP_SWITCHER_MCP_ENABLED=1

LITELLM_MCP_SWITCHER_WEBUI_REFRESH_SECONDS=30
